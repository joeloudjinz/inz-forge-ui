{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "@analogjs/vitest-angular:test": {
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/vitest.workspace.ts"]
    },
    "@nx/vite:test": {
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/vitest.workspace.ts"]
    },
    "component-test": {
      "executor": "@nx/cypress:cypress",
      "options": {
        "testingType": "component",
        "skipServe": true
      },
      "cache": true
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "{projectRoot}/**/*.ts",
          "{projectRoot}/**/*.html",
          "{projectRoot}/**/*.vue"
        ]
      }
    }
  },
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    }
  ]
}
